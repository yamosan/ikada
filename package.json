{
	"name": "nenrin",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"bin": {
		"nenrin": "./dist/cli/index.js"
	},
	"scripts": {
		"dev:app": "vite",
		"dev:cli": "tsc -b tsconfig.node.json && NODE_ENV=development node dist/cli/index.js",
		"build": "run-s build:app build:cli",
		"build:app": "tsc -b tsconfig.browser.json && vite build",
		"build:cli": "tsc -b tsconfig.node.json",
		"type-check": "tsc -b --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"dependencies": {
		"@ark-ui/react": "^5.37.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@hono/node-server": "^1.19.9",
		"@hono/standard-validator": "^0.2.2",
		"@internationalized/date": "^3.12.0",
		"@tanstack/react-virtual": "^3.13.19",
		"commander": "^14.0.3",
		"eventsource-client": "^1.2.0",
		"hono": "^4.12.2",
		"lucide-react": "^0.575.0",
		"open": "^11.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"npm-run-all": "^4.1.5",
		"tailwindcss": "^4.2.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1"
	}
}
