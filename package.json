{
	"name": "json-log-viewer",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "run-p --print-label dev:* dev:app dev:cli",
		"dev:app": "vite",
		"dev:cli": "tsc -b tsconfig.node.json && NODE_ENV=development node dist/cli/index.js",
		"build": "run-s build:app build:cli",
		"build:app": "tsc -b tsconfig.browser.json && vite build",
		"build:cli": "tsc -b tsconfig.node.json",
		"type-check": "tsc -b --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"dependencies": {
		"@hono/node-server": "^1.19.9",
		"commander": "^14.0.3",
		"hono": "^4.12.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"npm-run-all": "^4.1.5",
		"typescript": "~5.9.3",
		"vite": "^7.3.1"
	}
}
