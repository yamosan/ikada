{
	"name": "ikada",
	"version": "0.1.0",
	"description": "A local web UI for exploring line-based logs from the command line.",
	"keywords": [
		"cli",
		"json",
		"log",
		"log-viewer",
		"ikada"
	],
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"files": [
		"dist"
	],
	"bin": {
		"ikada": "./dist/cli/index.js"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"hooks:install": "lefthook install",
		"dev:app": "vite",
		"dev:cli": "tsc -b tsconfig.node.json && NODE_ENV=development node dist/cli/index.js",
		"build": "run-s build:app build:cli",
		"build:app": "tsc -b tsconfig.browser.json && vite build",
		"build:cli": "tsc -b tsconfig.node.json",
		"type-check": "tsc -b --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"dependencies": {
		"@ark-ui/react": "^5.37.2",
		"@hono/node-server": "^2.0.5",
		"@hono/standard-validator": "^0.2.2",
		"@internationalized/date": "^3.12.2",
		"@tanstack/react-virtual": "^3.14.2",
		"clsx": "^2.1.1",
		"commander": "^15.0.0",
		"eventsource-client": "^1.2.0",
		"hono": "^4.12.25",
		"lucide-react": "^1.18.0",
		"open": "^11.0.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"valibot": "^1.4.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"lefthook": "^2.1.9",
		"npm-run-all": "^4.1.5",
		"tailwindcss": "^4.3.1",
		"typescript": "~6.0.3",
		"vite": "^8.0.16"
	}
}
